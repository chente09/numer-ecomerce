rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== FUNCIONES HELPER ====================

    function isAdmin() {
      return request.auth != null &&
        'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    function isDistributor(distributorId) {
      return request.auth != null && request.auth.uid == distributorId;
    }

    // ==================== USUARIOS ====================

    match /users/{userId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId)
        || isAdmin();
      match /{subcollection}/{docId} {
        allow read, write: if (request.auth != null && request.auth.uid == userId)
          || isAdmin();
      }
    }

    // ==================== LOGS ====================

    match /user_activity_logs/{logId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete: if (request.auth != null && resource.data.userId == request.auth.uid)
        || isAdmin();
      allow update: if false;
    }

    // ==================== DISTRIBUIDORES (INVENTARIO) ====================

    match /distributors_inventory/{docId} {
      allow read: if isAdmin() || isDistributor(resource.data.distributorId);
      allow create: if isAdmin();
      allow update: if isAdmin() || isDistributor(resource.data.distributorId);
      // Distribuidor puede eliminar su propio item (cuando stock llega a 0 tras venta)
      allow delete: if isAdmin() || isDistributor(resource.data.distributorId);
    }

    match /distributor_inventory_movements/{docId} {
      allow read: if isAdmin() || isDistributor(resource.data.distributorId);
      allow create: if isAdmin() || isDistributor(request.resource.data.distributorId);
      allow update, delete: if isAdmin();
    }

    match /distributor_ledger/{docId} {
      allow read: if isAdmin() || isDistributor(resource.data.distributorId);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /payment_details/{docId} {
      allow read: if isAdmin() || isDistributor(resource.data.distributorId);
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ==================== ENVÍOS A DISTRIBUIDORES ====================

    match /shipments/{shipmentId} {
      allow read: if isAdmin() || isDistributor(resource.data.distributorId);
      allow create: if isAdmin();
      // Admin actualiza todo; distribuidor solo puede confirmar entrega (sent → delivered)
      allow update: if isAdmin() || (
        request.auth != null &&
        resource.data.distributorId == request.auth.uid &&
        resource.data.status == 'sent' &&
        request.resource.data.status == 'delivered' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveredAt'])
      );
      allow delete: if isAdmin();
    }

    // ==================== PEDIDOS ====================

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.distributorId == request.auth.uid)
        || (request.auth != null && resource.data.userId == request.auth.uid);
      // Solo el admin puede actualizar (cambiar estado, agregar tracking).
      // La creación la hace el backend vía Admin SDK, que ignora estas reglas.
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    match /preOrders/{preOrderId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // ==================== CUPONES ====================

    match /couponUsage/{docId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // ==================== INVENTARIO (MOVIMIENTOS) ====================

    match /inventoryMovements/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin(); // Admin genera logs desde frontend al transferir stock
      allow update, delete: if false;
    }

    // ==================== EVENTOS ====================

    match /races/{raceId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['inscritosActuales', 'updatedAt'])
            && request.resource.data.inscritosActuales == resource.data.inscritosActuales + 1);
    }

    match /race-inscriptions/{inscriptionId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ==================== RESEÑAS ====================

    match /reviews/{reviewId} {
      allow read: if resource.data.approved == true
        || isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==================== PROMOCIONES ====================

    match /promotions/{promotionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appliedPromotions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================== PRODUCTOS ====================

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['views', 'updatedAt']);
    }

    match /productVariants/{variantId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Solo admins pueden modificar variantes — el stock se actualiza via Admin SDK (backend)
      allow update: if isAdmin();
    }

    // ==================== CATÁLOGO ====================

    match /categories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /colors/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sizes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================== TECNOLOGÍAS ====================

    match /technologies/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================== DISTRIBUIDORES AUTORIZADOS ====================

    match /authorized_distributors/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /distributor_requests/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ==================== CONFIGURACIÓN UI ====================

    match /heroes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customHeroItems/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /heroProducts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /heroProductsConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /genderSectionConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /genderSectionItems/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instagram_posts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /modelImages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================== NEWSLETTER ====================

    match /newsletter_subscriptions/{docId} {
      allow create: if true;
      allow read: if isAdmin() || request.auth != null;
      allow delete: if isAdmin();
      // Solo el propio usuario o admin pueden actualizar su suscripción
      allow update: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid)
        || (request.auth == null && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['isActive', 'updatedAt']));
    }

    // ==================== SITEMAP ====================

    match /sitemap/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

  }
}
